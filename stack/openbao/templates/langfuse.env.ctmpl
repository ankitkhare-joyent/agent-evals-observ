{{- with secret "secret/data/langfuse/infra" -}}
# Rendered by OpenBao Agent from secret/langfuse/infra. Lives only in a tmpfs volume.
DATABASE_URL=postgresql://postgres:{{ .Data.data.postgres_password }}@postgres:5432/postgres
SALT={{ .Data.data.salt }}
ENCRYPTION_KEY={{ .Data.data.encryption_key }}
NEXTAUTH_SECRET={{ .Data.data.nextauth_secret }}
CLICKHOUSE_PASSWORD={{ .Data.data.clickhouse_password }}
REDIS_AUTH={{ .Data.data.redis_password }}
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY={{ .Data.data.minio_password }}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY={{ .Data.data.minio_password }}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY={{ .Data.data.minio_password }}
LANGFUSE_INIT_USER_PASSWORD={{ .Data.data.init_user_password }}
LANGFUSE_INIT_PROJECT_PUBLIC_KEY={{ .Data.data.project_public_key }}
LANGFUSE_INIT_PROJECT_SECRET_KEY={{ .Data.data.project_secret_key }}
{{- end }}
