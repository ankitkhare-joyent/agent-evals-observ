<!-- ClickHouse writes a lot of self-monitoring into system.* tables (metric_log, trace_log, ...).
     On a laptop that is a big share of its CPU. Langfuse doesn't need them; production clusters often keep a few. -->
<clickhouse>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
    <!-- keep query_log: useful when you want to see what Langfuse asks ClickHouse -->
</clickhouse>
